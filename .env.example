# ===========================================
# MCP Hub - متغيرات البيئة المرجعية
# ===========================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب الحاجة

# --- قاعدة البيانات (PostgreSQL) ---
# رابط الاتصال - يُستخدم عند تشغيل mcp-hub مع --database-url
DATABASE_URL=postgresql://mcphub:YOUR_PASSWORD@localhost:5432/mcphub

# أو استخدم المتغيرات المنفصلة (لـ docker-compose):
POSTGRES_USER=mcphub
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
POSTGRES_DB=mcphub
POSTGRES_PORT=5432

# --- حماية واجهة الويب ---
# عند تعيينه، تصبح الواجهة و /api محمية
# استخدم: Basic Auth أو Bearer token أو ?token=xxx
MCP_HUB_UI_TOKEN=your-secret-ui-token

# --- حماية نقطة MCP (/mcp) ---
# توكن منفصل للاتصال بـ MCP (Cursor، Claude Desktop، Claude.ai، إلخ)
# أضفه في إعداد العميل: headers: { "Authorization": "Bearer <token>" }
# أو استخدم ?token=xxx في الرابط للعملاء الذين لا يدعمون headers
MCP_HOST_TOKEN=your-mcp-connection-token

# --- OAuth لـ Claude.ai (اختياري) ---
# عند تعيين MCP_HOST_TOKEN، يدعم Hub تلقائياً OAuth 2.0 لـ Claude.ai
# إذا كان Hub خلف reverse proxy، عيّن الرابط العام للتأكد من صحة metadata:
# MCP_HUB_PUBLIC_URL=https://mcp.yourdomain.com

# --- كلمة مرور الموافقة على الاتصال (اختياري) ---
# عند تعيينه، يظهر للمستخدم صفحة لإدخال كلمة المرور قبل إكمال OAuth
# شاركها فقط مع من تريد منحهم الوصول
# MCP_OAUTH_APPROVAL_PASSWORD=your-approval-password

# --- اختياري: متغيرات إضافية لخوادم MCP ---
# تُحقن في بيئة كل خادم MCP (JSON)
# MCP_HUB_ENV='{"API_KEY":"xxx","DB_URL":"..."}'
